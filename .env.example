TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
POINTS_PER_WIN=10
MIN_POINTS_PER_WIN=1
HINT_PENALTY=2
MAX_HINT_PENALTY=6
SPEED_BONUS_FAST=5
SPEED_BONUS_MED=2
STREAK_BONUS_3=2
STREAK_BONUS_5=5
STREAK_BONUS_10=10
# Локально: ./data/bot.db | в Docker: /app/data/bot.db (задаётся в compose)
DATABASE_PATH=./data/bot.db
# preset — готовые загадки; ai — нейросеть
RIDDLE_SOURCE=preset
# true — показывать ответ под загадкой (для тестов)
SHOW_ANSWER=false
# false — не печатать промпты/ответы Gemini в консоль
LOG_GEMINI_REQUESTS=true
NICK_TIMEZONE=Europe/Moscow
# Сколько ников за один запрос Gemini (5–10); перекаты берут из очереди
NICK_STACK_SIZE=8
# Титул недели для победителя прошлой недели
WEEKLY_TITLE_ENABLED=true
# Публичные анонсы достижений в чат
ACHIEVEMENTS_ANNOUNCE=true
# Кастомные Telegram-эмодзи для титулов (опционально)
# TITLE_EMOJI_CARRY=
# TITLE_EMOJI_DIVINE=
# Токсичные обзывательства при провалах (пул до 300, +20/день через Gemini)
INSULTS_ENABLED=true
INSULT_MAX_POOL=300
INSULT_DAILY_BATCH=20
# Флуд-реплики при частых раундах (8–16: про работу, иначе: общие)
FLOOD_TAUNTS_ENABLED=true
WORK_HOURS_START=8
WORK_HOURS_END=16
FLOOD_WINDOW_MINUTES=30
FLOOD_TAUNTS_MAX_PER_HOUR=2
