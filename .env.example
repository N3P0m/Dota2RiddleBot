TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
POINTS_PER_WIN=10
MIN_POINTS_PER_WIN=1
HINT_PENALTY=2
MAX_HINT_PENALTY=6
SPEED_BONUS_FAST=5
SPEED_BONUS_MED=2
STREAK_BONUS_3=2
STREAK_BONUS_5=5
STREAK_BONUS_10=10
# Локально: ./data/bot.db | в Docker: /app/data/bot.db (задаётся в compose)
DATABASE_PATH=./data/bot.db
# preset — готовые загадки; ai — нейросеть
RIDDLE_SOURCE=preset
# true — показывать ответ под загадкой (для тестов)
SHOW_ANSWER=false
# false — не печатать промпты/ответы Gemini в консоль
LOG_GEMINI_REQUESTS=true
NICK_TIMEZONE=Europe/Moscow
# Сколько ников за один запрос Gemini (5–10); перекаты берут из очереди
NICK_STACK_SIZE=8
# Титул недели для победителя прошлой недели
WEEKLY_TITLE_ENABLED=true
# Публичные анонсы достижений в чат
ACHIEVEMENTS_ANNOUNCE=true
# Кастомные Telegram-эмодзи для рангов (опционально)
# TITLE_EMOJI_HERALD=
# TITLE_EMOJI_GUARDIAN=
# TITLE_EMOJI_CRUSADER=
# TITLE_EMOJI_ARCHON=
# TITLE_EMOJI_LEGEND=
# TITLE_EMOJI_ANCIENT=
# TITLE_EMOJI_DIVINE=
# TITLE_EMOJI_IMMORTAL=
# Старые ключи TITLE_EMOJI_CREEP/SUPPORT/CARRY/CORE тоже работают как fallback
# Токсичные обзывательства при провалах (пул до 300, +20/день через Gemini)
INSULTS_ENABLED=true
INSULT_MAX_POOL=300
INSULT_DAILY_BATCH=20
# Флуд-реплики при частых раундах (8–16: про работу, иначе: общие)
FLOOD_TAUNTS_ENABLED=true
WORK_HOURS_START=8
WORK_HOURS_END=16
FLOOD_WINDOW_MINUTES=30
FLOOD_TAUNTS_MAX_PER_HOUR=2
# true — кнопка «Отменить бой» в PvP (тест, без штрафов)
TEST_BATTLE_CANCEL=false
# Доля возврата при продаже героя (0.5 = 50% от цены в магазине)
HERO_SELL_REFUND_RATE=0.5
# false — не писать в консоль сообщения и callback от пользователей
LOG_INCOMING_MESSAGES=true
# Dev: /emo-map — глобальный маппер custom emoji → герои (data/hero-emoji-map.json)
HERO_EMOJI_MAP_DEV=false
HERO_EMOJI_MAP_PATH=./data/hero-emoji-map.json
