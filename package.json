{
  "name": "dota2heroes-bot",
  "version": "1.0.0",
  "description": "Telegram bot: guess Dota 2 heroes from AI riddles",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "generate-heroes": "tsx scripts/generate-heroes.ts",
    "assign-difficulty": "tsx scripts/assign-hero-difficulty.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "fast-levenshtein": "^3.0.0",
    "grammy": "^1.43.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
